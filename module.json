{
  "id": "changeling-faces",
  "title": "Changeling: Mil Faces",
  "description": "Automatiza o traço Metamorfo (Shapechanger) do changeling: memorize rostos clicando em tokens, envie imagens em tempo real (mesmo sem ser o host) e troque de aparência numa paleta rápida no Token HUD, no estilo do Token Variant Art.",
  "version": "1.0.0",
  "authors": [
    {
      "name": "barao",
      "url": "https://github.com/guij2"
    }
  ],
  "url": "https://github.com/guij2/changeling-faces",
  "manifest": "https://github.com/guij2/changeling-faces/releases/latest/download/module.json",
  "download": "https://github.com/guij2/changeling-faces/releases/download/v1.0.0/changeling-faces.zip",
  "bugs": "https://github.com/guij2/changeling-faces/issues",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/changeling-faces.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "recommends": [
      {
        "id": "token-variants",
        "type": "module",
        "reason": "Opcional: os rostos memorizados também aparecem como variantes compartilhadas no HUD do Token Variant Art."
      }
    ]
  },
  "socket": true
}
